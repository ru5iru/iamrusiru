<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE html>
<html xmlns='http://www.w3.org/1999/xhtml' xmlns:b='http://www.google.com/2005/gml/b' xmlns:data='http://www.google.com/2005/gml/data' xmlns:expr='http://www.google.com/2005/gml/expr' b:version='2' b:layoutsVersion='3' b:defaultwidgetversion='2' b:responsive='true' b:css='false' expr:dir='data:blog.languageDirection' expr:lang='data:blog.locale'>
<head>
  <meta charset='utf-8'/>
  <meta content='width=device-width, initial-scale=1' name='viewport'/>
  <title><data:view.title.escaped/></title>
  <!-- Own the metadata here: no all-head-content include that can duplicate it. -->
  <link expr:href='data:blog.canonicalUrl' rel='canonical'/>
  @@DESCRIPTION_METADATA@@
  <meta expr:content='data:view.title' property='og:title'/>
  <meta expr:content='data:blog.canonicalUrl' property='og:url'/>
  <meta expr:content='data:blog.title' property='og:site_name'/>
  <meta expr:content='data:view.isPost ? "article" : "website"' property='og:type'/>
  <meta expr:content='data:blog.postImageUrl ?: "@@SOCIAL_IMAGE@@"' property='og:image'/>
  <meta content='summary_large_image' name='twitter:card'/>
  <meta content='@ru5iru' name='twitter:creator'/>
  <meta expr:content='data:view.title' name='twitter:title'/>
  <meta expr:content='data:blog.postImageUrl ?: "@@SOCIAL_IMAGE@@"' name='twitter:image'/>
  <b:if cond='data:view.isSearch or data:view.isError or data:view.url contains "/p/privacy-policy.html" or data:view.url contains "/p/cookie-policy.html"'>
    <meta content='noindex,follow' name='robots'/>
  <b:else/>
    <meta content='index,follow,max-image-preview:large' name='robots'/>
  </b:if>
  <link expr:href='data:blog.homepageUrl + "favicon.ico"' rel='icon'/>
  <link expr:href='data:blog.homepageUrl + "feeds/posts/default?alt=rss"' rel='alternate' title='Posts RSS' type='application/rss+xml'/>
  <link expr:href='data:blog.homepageUrl + "feeds/posts/default"' rel='alternate' title='Posts Atom' type='application/atom+xml'/>
  <link href='https://fonts.googleapis.com' rel='preconnect'/>
  <link crossorigin='anonymous' href='https://fonts.gstatic.com' rel='preconnect'/>
  <link href='https://fonts.googleapis.com/css2?family=DM+Serif+Display:ital@0;1&amp;family=Roboto:wght@300;400;500;700&amp;family=JetBrains+Mono:wght@400;500;600&amp;display=swap' rel='stylesheet'/>
  <b:skin><![CDATA[
@@CSS@@
  ]]></b:skin>
  <script type='text/javascript'>//<![CDATA[
    try {
      var savedTheme = localStorage.getItem('theme');
      document.documentElement.classList.toggle('dark', savedTheme ? savedTheme === 'dark' : matchMedia('(prefers-color-scheme: dark)').matches);
    } catch (_) { document.documentElement.classList.toggle('dark', matchMedia('(prefers-color-scheme: dark)').matches); }
  //]]></script>
</head>
<body class='min-h-screen bg-background'>
  <a class='skip-link' href='#main-content'>Skip to main content</a>
  <div aria-hidden='true' id='reading-progress'/>
  <header class='site-header py-5 border-b border-divider bg-background sticky top-0 z-50'>
    <div class='max-w-6xl mx-auto px-6'>
      <nav aria-label='Main navigation' class='flex items-center justify-between gap-8'>
        <a aria-label='iamrusiru home' data-home='' expr:href='data:blog.homepageUrl' class='font-display text-2xl font-bold tracking-tight'><span class='text-display'>iam</span><span class='text-primary'>rusiru</span></a>
        <div class='hidden md:flex items-center gap-8 ml-auto'>
          <a expr:href='data:blog.homepageUrl' class='text-sm font-medium text-caption hover:text-primary'>Home</a>
          <a expr:href='data:blog.homepageUrl + "p/about.html"' class='text-sm font-medium text-caption hover:text-primary'>About me</a>
          <a href='https://rusiru.lovable.app/' target='_blank' rel='noopener noreferrer' class='text-sm font-medium text-caption hover:text-primary'>Portfolio<span class='sr-only'> (opens in new tab)</span></a>
          <a expr:href='data:blog.homepageUrl + "p/contact.html"' class='px-5 py-2 text-sm font-medium border border-divider rounded-full hover:border-primary hover:text-primary'>Contact Me</a>
        </div>
        <div class='flex items-center gap-3'>
          <button aria-label='Use dark theme' aria-pressed='false' class='w-9 h-9 rounded-full bg-warm flex items-center justify-center text-caption hover:text-primary' data-theme-toggle='' hidden='hidden' type='button'>
            <svg aria-hidden='true' class='theme-icon moon-icon' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2'><path d='M20.9 13A9 9 0 0 1 11 3.1 9 9 0 1 0 20.9 13Z'/></svg>
            <svg aria-hidden='true' class='theme-icon sun-icon' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2'><circle cx='12' cy='12' r='4'/><path d='M12 2v2m0 16v2M2 12h2m16 0h2M5 5l1.5 1.5m11 11L19 19M5 19l1.5-1.5m11-11L19 5'/></svg>
          </button>
          <button aria-label='Toggle navigation' aria-expanded='false' aria-controls='mobile-menu' class='md:hidden text-display p-1' data-menu-toggle='' hidden='hidden' type='button'><svg aria-hidden='true' width='24' height='24' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2'><path d='M3 6h18M3 12h18M3 18h18'/></svg></button>
        </div>
      </nav>
      <nav aria-label='Mobile navigation' id='mobile-menu' class='md:hidden mt-4 pb-4 flex flex-col gap-4 border-t border-divider pt-4'>
        <a expr:href='data:blog.homepageUrl' class='text-sm font-medium text-caption'>Home</a>
        <a expr:href='data:blog.homepageUrl + "p/about.html"' class='text-sm font-medium text-caption'>About me</a>
        <a href='https://rusiru.lovable.app/' target='_blank' rel='noopener noreferrer' class='text-sm font-medium text-caption'>Portfolio</a>
        <a expr:href='data:blog.homepageUrl + "p/contact.html"' class='text-sm font-medium text-caption'>Contact Me</a>
      </nav>
    </div>
  </header>
  <main id='main-content'>
    <b:if cond='data:view.isHomepage'><div class='hero'>@@HERO@@</div></b:if>
    <div expr:class='data:view.isMultipleItems ? "listing-section border-t border-divider" : "content-section"'>
    <div expr:class='data:view.isMultipleItems ? "content-frame listing-frame" : "content-frame"' expr:data-page-kind='data:view.isPage ? "page" : "content"'>
    <b:section id='main' class='main' maxwidgets='1' showaddelement='no'>
      <b:widget id='Blog1' type='Blog' version='2' locked='yes' title='Blog Posts'>
        <b:includable id='main' var='this'>
          <b:if cond='data:view.isError'>
            <section class='max-w-3xl mx-auto py-20 text-center'><p class='font-display text-6xl font-bold text-primary mb-3'>404</p><h1 class='font-display text-3xl md:text-4xl font-semibold mb-4'>Page not found</h1><p class='text-muted-foreground mb-8'>This page does not exist or may have moved.</p><a class='inline-block px-8 py-3 bg-primary text-primary-foreground rounded-full font-medium' expr:href='data:blog.homepageUrl'>Go to homepage</a>@@RECENT_POSTS@@</section>
          <b:elseif cond='data:view.isSingleItem'/>
            <b:loop values='data:posts' var='post'>
              <b:if cond='data:view.isPage'>
                <article class='blogger-page max-w-4xl mx-auto px-6 py-16'>
                  <b:if cond='data:post.body contains "data-migrated-page"'><data:post.body/><b:else/><h1 class='font-display text-4xl md:text-5xl mb-10'><data:post.title/></h1><div class='post-content'><data:post.body/></div></b:if>
                </article>
              <b:else/>
                <b:include data='post' name='article'/>
              </b:if>
            </b:loop>
          <b:else/>
            <section>
              <div>
                <div class='flex items-center gap-2 mb-8'><div class='w-1 h-6 bg-primary rounded-full'/><b:if cond='data:view.isHomepage'><h2 class='font-display text-2xl font-semibold'>Latest Posts</h2><b:else/><h1 class='font-display text-2xl font-semibold'><data:view.title/></h1></b:if></div>
                <b:if cond='data:view.isSearch'><a class='inline-block text-sm text-primary mb-6' expr:href='data:blog.homepageUrl'>Clear filters →</a></b:if>
                <div class='flex flex-col lg:flex-row gap-12'>
                  <div class='flex-1 min-w-0'>
                    <b:if cond='data:posts.empty'><div class='py-16 text-center'><p class='text-lg mb-4'>No posts found.</p><a class='text-primary' expr:href='data:blog.homepageUrl'>Show all posts</a></div></b:if>
                    <b:loop values='data:posts' var='post'><b:include data='post' name='card'/></b:loop>
                    <b:include name='pager'/>
                  </div>
                </div>
              </div>
            </section>
          </b:if>
        </b:includable>
        <b:includable id='card' var='post'>
          <article class='group py-6 border-b border-divider flex gap-5 hover:border-primary/30'>
            @@CARD_IMAGE@@
            <div class='flex-1 min-w-0'>
              <b:include data='post' name='topicBadge'/>
              <h2 class='font-display text-lg md:text-xl font-medium mb-2 leading-snug line-clamp-2'><a expr:href='data:post.url' class='group-hover:text-primary'><data:post.title/></a></h2>
              <p class='text-body text-sm leading-relaxed line-clamp-2 mb-3'>@@EXCERPT_MARKUP@@</p>
              <div class='flex flex-wrap gap-1.5 mb-3'>@@CARD_TAGS@@</div>
              <div class='post-meta flex items-center gap-3'><img src='@@PORTRAIT@@' alt='' width='28' height='28' class='w-7 h-7 rounded-full object-cover' loading='lazy'/><div class='flex flex-wrap items-center gap-x-2 gap-y-1 text-xs text-muted-foreground'><span class='font-medium text-foreground'><data:post.author.name/></span><span aria-hidden='true'>·</span><b:include data='post' name='postDate'/><span aria-hidden='true'>·</span><span data-card-reading=''><b:include data='post' name='readingTime'/></span></div></div>
            </div>
          </article>
        </b:includable>
        <b:includable id='article' var='post'>
          <article class='py-12' itemscope='itemscope' itemtype='https://schema.org/BlogPosting'>
            <div>
              <a class='inline-flex items-center gap-2 text-sm leading-none text-caption hover:text-primary mb-8' expr:href='data:blog.homepageUrl'>@@BACK_ICON@@<span>Back to all posts</span></a>
              <div class='flex flex-col lg:flex-row gap-10'>
                <div class='flex-1 min-w-0 max-w-3xl'>
                  <div class='article-meta flex flex-wrap items-center gap-3 mb-4'><b:include data='post' name='topicBadge'/><span class='text-sm text-muted-foreground'><b:include data='post' name='postDate'/></span><span class='text-sm text-muted-foreground' aria-hidden='true'>·</span><span class='inline-flex items-center gap-1.5 text-sm text-muted-foreground'>@@CLOCK_ICON@@<span data-reading-time=''><b:include data='post' name='readingTime'/></span></span></div>
                  <h1 class='font-display text-3xl md:text-4xl lg:text-5xl font-semibold leading-tight mb-4' itemprop='headline'><data:post.title/></h1>
                  <link itemprop='mainEntityOfPage' expr:href='data:blog.canonicalUrl'/>
                  <b:if cond='data:post.lastUpdated'><meta itemprop='dateModified' expr:content='data:post.lastUpdated.iso8601'/></b:if>
                  <div class='flex flex-wrap gap-2 mb-8'>@@ARTICLE_TAGS@@</div>
                  <div class='flex items-center gap-3 mb-10 pb-8 border-b border-divider' itemprop='author' itemscope='itemscope' itemtype='https://schema.org/Person'><img src='@@PORTRAIT@@' alt='' width='40' height='40' class='w-10 h-10 rounded-full object-cover'/><div><p class='text-sm font-medium' data-post-author='' itemprop='name'><data:post.author.name/></p><p class='text-xs text-muted-foreground'>Software Engineer &amp; Writer</p><link itemprop='url' expr:href='data:blog.homepageUrl + "p/about.html"'/></div></div>
                  <div class='post-content' data-article-body='' itemprop='articleBody'><data:post.body/></div>
                  @@SHARE@@
                  <section class='mt-8 rounded-xl border border-divider bg-warm/40 p-5'><h2 class='font-display text-lg font-semibold mb-2'>Cite this post</h2><p class='text-sm leading-relaxed mb-3'>Found this useful? Feel free to reference it in your own work:</p><code class='block font-mono text-xs text-body bg-background border border-divider rounded-lg px-4 py-3 break-all' data-citation=''><data:post.author.name/>. <data:post.title/>. <data:post.url/></code></section>
                  @@RELATED_POSTS@@
                  <div data-post-faq=''/>
                  <div class='mt-12 p-6 rounded-xl bg-muted/30 border border-divider'><div class='flex items-center gap-4 mb-3'><img src='@@PORTRAIT@@' alt='Rusiru Rathmina' width='56' height='56' class='w-14 h-14 rounded-full object-cover'/><div><p class='font-display font-semibold'>Written by <data:post.author.name/></p><p class='text-sm text-muted-foreground'>Associate Software Engineer at Omobio, Colombo, Sri Lanka</p></div></div><p class='text-body text-sm leading-relaxed'>I build full-stack applications with React, Java, Spring Boot, and AWS. I write about code, career growth, side projects, and the human side of software engineering. <a class='text-primary font-medium' expr:href='data:blog.homepageUrl + "p/about.html"'>Learn more about me →</a></p></div>
                  <!-- Blogger supplies its own maintained threaded comment and editor includables. -->
                  <b:if cond='data:post.allowComments'><b:include data='post' name='commentPicker'/></b:if>
                  <b:include name='pager'/>
                </div>
                <aside class='hidden lg:block w-64 flex-shrink-0' data-toc='' hidden='hidden'><nav aria-label='Table of contents' class='toc-panel sticky top-24 rounded-xl border border-divider bg-card p-5'><h2 class='font-display text-base font-semibold mb-3'>Contents</h2><div class='toc-list' data-toc-list=''/></nav></aside>
              </div>
            </div>
          </article>
        </b:includable>
        <b:includable id='topicBadge' var='post'>
          <b:loop values='data:post.labels' var='label'><b:if cond='data:label.name in {"Engineering", "Career", "Tutorials", "Side Projects", "Reading", "Personal"}'><a class='blog-tag mb-2' expr:href='data:label.url'><data:label.name/></a></b:if></b:loop>
        </b:includable>
        <b:includable id='readingTime' var='post'><span>@@READTIME_MARKUP@@</span></b:includable>
        <b:includable id='postDate' var='post'>@@DATE_MARKUP@@</b:includable>
        <b:includable id='pager'>
          <nav aria-label='Post pagination' class='flex flex-wrap items-center justify-between gap-4 mt-10'>
            <b:if cond='data:newerPageUrl'><a class='px-6 py-3 border border-divider rounded-full hover:text-primary' expr:href='data:newerPageUrl' rel='prev'>← Newer posts</a></b:if>
            <b:if cond='data:olderPageUrl'><a class='px-8 py-3 bg-primary text-primary-foreground rounded-full' expr:href='data:olderPageUrl' rel='next'>Older posts →</a></b:if>
          </nav>
        </b:includable>
      </b:widget>
    </b:section>
    <b:if cond='!data:view.isSingleItem and !data:view.isError'>
      <aside class='listing-sidebar'>
        <div class='space-y-10'>
          @@TOPICS@@
          <b:section id='sidebar' class='sidebar' showaddelement='yes'>
            <b:widget id='Label1' type='Label' version='2' title='Tags' locked='no'>
              <b:widget-settings><b:widget-setting name='sorting'>ALPHA</b:widget-setting><b:widget-setting name='display'>CLOUD</b:widget-setting><b:widget-setting name='showFreqNumbers'>false</b:widget-setting></b:widget-settings>
              <b:includable id='main'><h2 class='font-display text-lg font-semibold mb-4'><data:title/></h2><div class='blogger-labels'><b:loop values='data:labels' var='label'><b:if cond='!(data:label.name in {"Engineering", "Career", "Tutorials", "Side Projects", "Reading", "Personal"})'><a expr:href='data:label.url' expr:data-label-count='data:label.count'>#<data:label.name/> <span class='sr-only'>(<data:label.count/> posts)</span></a></b:if></b:loop></div></b:includable>
            </b:widget>
            <b:widget id='BlogArchive1' type='BlogArchive' version='2' title='Blog Archive' locked='no'/>
          </b:section>
          @@CONNECT@@
          <form expr:action='data:blog.homepageUrl + "search"' method='get' role='search'><label class='font-display text-lg block mb-4' for='blog-search'>Search this blog</label><div class='flex gap-2'><input class='min-w-0 w-full px-3 py-2 rounded-lg border border-divider bg-background' id='blog-search' name='q' placeholder='Search posts…' type='search' expr:value='data:view.search.query'/><button class='px-4 py-2 bg-primary text-primary-foreground rounded-full' type='submit'>Search</button></div></form>
        </div>
      </aside>
    </b:if>
    </div>
    </div>
  </main>
  <button aria-label='Back to top' class='fixed bottom-6 right-6 z-50 w-11 h-11 bg-primary text-primary-foreground rounded-full shadow-lg flex items-center justify-center hover:bg-primary/90' data-back-top='' hidden='hidden' type='button'>@@UP_ICON@@</button>
  <div class='site-footer'>@@FOOTER@@</div>
  <script id='blogger-post-data' type='application/json'>@@POST_DATA@@</script>
  <script type='text/javascript'>//<![CDATA[
@@SCRIPT@@
  //]]></script>
</body>
</html>
